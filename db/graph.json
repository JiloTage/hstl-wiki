{
  "nodes": [
    {
      "id": "the-king-in-yellow",
      "title": "黄衣の王 (戯曲)",
      "url": "articles/the-king-in-yellow.html",
      "summary": "ロバート・W・チェンバーズの連作短編集に登場する架空の戯曲。読む者を狂気に陥れるとされ、コズミック・ホラー文学の源流のひとつとなった。",
      "is_root": true
    },
    {
      "id": "robert-w-chambers",
      "title": "ロバート・W・チェンバーズ",
      "url": "articles/robert-w-chambers.html",
      "summary": "ロバート・ウィリアム・チェンバーズ（1865-1933）は、アメリカの画家・小説家。初期の怪奇短編集『黄衣の王』（1895年）でウィアード・フィクション史に不朽の足跡を残したが、その後は大衆ロマンス小説の量産作家として知られた。",
      "is_root": false
    },
    {
      "id": "hastur",
      "title": "ハスター",
      "url": "articles/hastur.html",
      "summary": "アンブローズ・ビアスの短編に端を発し、チェンバーズ、ラヴクラフト、ダーレスらによって変容を重ねた多義的な名称。牧神から宇宙的恐怖の神格へと、一世紀以上にわたり意味を増殖させ続けている。",
      "is_root": false
    },
    {
      "id": "carcosa",
      "title": "カルコサ",
      "url": "articles/carcosa.html",
      "summary": "アメリカ怪奇文学に繰り返し登場する架空の都市。アンブローズ・ビアスが創造し、ロバート・W・チェンバーズが『黄衣の王』で神秘的な異界として発展させ、クトゥルフ神話やHBOドラマ『トゥルー・ディテクティブ』にまで影響を及ぼした。",
      "is_root": false
    },
    {
      "id": "yellow-sign",
      "title": "黄の印",
      "url": "articles/yellow-sign.html",
      "summary": "『黄衣の王』の戯曲と不可分に結びついた紋章的記号。その正確な形状は描写されないが、目撃した者を戯曲の影響下に引き込み、精神を不可逆的に変容させるとされる。情報そのものが災厄となる「認知汚染」の原型的モチーフとして、文学・ゲーム・現代ポップカルチャーに広く浸透している。",
      "is_root": false
    },
    {
      "id": "ambrose-bierce",
      "title": "アンブローズ・ビアス",
      "url": "articles/ambrose-bierce.html",
      "summary": "アンブローズ・グウィネット・ビアス（1842-1914?）は、アメリカの作家・ジャーナリスト。南北戦争の従軍体験に基づく戦争文学、『悪魔の辞典』、怪奇短編群で知られる。『カルコサの住人』と『羊飼いハイタ』で創造した「カルコサ」と「ハスター」の名は、チェンバーズを経てクトゥルフ神話の基盤となった。",
      "is_root": false
    },
    {
      "id": "weird-fiction",
      "title": "ウィアード・フィクション",
      "url": "articles/weird-fiction.html",
      "summary": "ウィアード・フィクション（Weird Fiction）は、恐怖、畏怖、宇宙的不安を核とする文学ジャンル。ホラー、ファンタジー、SFの境界を横断し、人間の認識を超えた「異質なもの」との遭遇を描く。ゴシック小説から派生し、ラヴクラフトにより理論的に確立された。",
      "is_root": false
    },
    {
      "id": "mimetic-hazard",
      "title": "ミーム汚染",
      "url": "articles/mimetic-hazard.html",
      "summary": "ミーム汚染（memetic hazard / cognitohazard）とは、特定の情報・記号・概念に接触すること自体が認知的・心理的な危害を引き起こすという概念。怪奇文学における「読むだけで狂気に陥る書物」から、現代の情報セキュリティにおける「情報ハザード」まで、フィクションと現実を横断する射程を持つ。",
      "is_root": false
    },
    {
      "id": "hp-lovecraft",
      "title": "H・P・ラヴクラフト",
      "url": "articles/hp-lovecraft.html",
      "summary": "ハワード・フィリップス・ラヴクラフト（1890-1937）は、アメリカの怪奇小説家・詩人・評論家。コズミック・ホラーの概念を確立し、クトゥルフ神話体系を創造した。ウィアード・フィクションの理論家としても知られ、20世紀怪奇文学最大の巨人である。",
      "is_root": false
    },
    {
      "id": "cthulhu-mythos",
      "title": "クトゥルフ神話",
      "url": "articles/cthulhu-mythos.html",
      "summary": "H・P・ラヴクラフトの作品群を核として複数の作家が共同で構築した架空の神話体系。ダーレスによる体系化を経て、TRPGやメディア展開を通じて世界的な文化現象となった。チェンバーズのハスターやカルコサを取り込みながら拡張された共有世界。",
      "is_root": false
    },
    {
      "id": "necronomicon",
      "title": "ネクロノミコン",
      "url": "articles/necronomicon.html",
      "summary": "H・P・ラヴクラフトが創造した架空の魔道書。「狂えるアラブ人」アブドゥル・アルハズレッドが著したとされ、クトゥルフ神話作品群において禁断の知識の象徴として機能する。チェンバーズの『黄衣の王』と構造的に共鳴する「読むこと自体が危険な書物」の頂点。",
      "is_root": false
    },
    {
      "id": "true-detective",
      "title": "トゥルー・ディテクティブ",
      "url": "articles/true-detective.html",
      "summary": "HBOが2014年から放送するアンソロジー形式の犯罪ドラマシリーズ。第1シーズンはロバート・W・チェンバーズ『黄衣の王』の世界観をルイジアナ州の連続殺人事件に移植し、文学的ホラーとテレビドラマの融合として高い評価を受けた。チェンバーズ再評価の契機ともなった画期的作品。",
      "is_root": false
    },
    {
      "id": "cosmic-horror",
      "title": "コズミック・ホラー",
      "url": "articles/cosmic-horror.html",
      "summary": "コズミック・ホラー（Cosmic Horror）は、広大な宇宙における人間の存在論的矮小さと無意味さに起因する恐怖を核とする文学・芸術の様式。ラヴクラフトが理論化した宇宙的無関心主義を思想的基盤とし、ウィアード・フィクションの中核的サブジャンルとして文学・映画・ゲームに広く浸透している。",
      "is_root": false
    },
    {
      "id": "fin-de-siecle",
      "title": "世紀末芸術",
      "url": "articles/fin-de-siecle.html",
      "summary": "世紀末芸術（フィン・ド・シエクル）とは、19世紀末のヨーロッパを中心に花開いた芸術・文学・思想の総称。象徴主義、退廃主義、唯美主義を主要な潮流とし、チェンバーズの『黄衣の王』の退廃的世界観に直接的な影響を与えた。",
      "is_root": false
    },
    {
      "id": "devils-dictionary",
      "title": "悪魔の辞典",
      "url": "articles/devils-dictionary.html",
      "summary": "『悪魔の辞典』（The Devil's Dictionary, 1906/1911）は、アンブローズ・ビアスが四半世紀にわたり新聞コラムとして連載し書籍化した風刺辞典。辞書形式を借りて人間社会のあらゆる制度・慣習を毒舌で再定義するアメリカ風刺文学の最高傑作のひとつ。",
      "is_root": false
    },
    {
      "id": "gothic-fiction",
      "title": "ゴシック小説",
      "url": "articles/gothic-fiction.html",
      "summary": "ゴシック小説（Gothic Fiction）は、18世紀後半の英国に端を発する文学ジャンル。ウォルポール『オトラント城奇譚』（1764年）を嚆矢として、ラドクリフ、ルイス、シェリー、ストーカーらが発展させ、ポーやル・ファニュを経てウィアード・フィクションやコズミック・ホラーへと分岐した。",
      "is_root": false
    },
    {
      "id": "scp-foundation",
      "title": "SCPファウンデーション",
      "url": "articles/scp-foundation.html",
      "summary": "SCPファウンデーション（SCP Foundation）は、2007年に英語圏のインターネット掲示板から生まれた共同創作型ホラーフィクション・プロジェクト。超常的存在やオブジェクトを収容する架空の秘密組織を舞台に、疑似科学的報告書の形式でコズミック・ホラーの伝統をインターネット時代に再構築した。",
      "is_root": false
    },
    {
      "id": "august-derleth",
      "title": "オーガスト・ダーレス",
      "url": "articles/august-derleth.html",
      "summary": "オーガスト・ウィリアム・ダーレス（1909-1971）は、アメリカの作家・編集者・出版人。ラヴクラフトの弟子としてアーカム・ハウス出版社を設立し、クトゥルフ神話の保存と体系化の両面で決定的な役割を果たした。",
      "is_root": false
    },
    {
      "id": "pallid-mask",
      "title": "蒼白の仮面",
      "url": "articles/pallid-mask.html",
      "summary": "「蒼白の仮面」（The Pallid Mask）は、チェンバーズの戯曲『黄衣の王』に登場する象徴的モチーフ。仮面舞踏会における「仮面などつけてはおらぬ」の台詞が体現する存在論的恐怖は、外見と本質の不可分性をめぐるコズミック・ホラーの核心を衝くものである。",
      "is_root": false
    },
    {
      "id": "call-of-cthulhu-trpg",
      "title": "クトゥルフの呼び声TRPG",
      "url": "articles/call-of-cthulhu-trpg.html",
      "summary": "1981年にケイオシアム社から発売されたテーブルトークRPG。サンディ・ピーターセンがデザインし、正気度（SAN値）システムの導入によりホラーTRPGというジャンルを確立した。日本では独自の受容と発展を遂げ、クトゥルフ神話の最大の伝播媒体となっている。",
      "is_root": false
    },
    {
      "id": "metafiction",
      "title": "メタフィクション",
      "url": "articles/metafiction.html",
      "summary": "フィクションでありながら自らのフィクション性を意識的に露呈・探求する文学的手法および作品群の総称。チェンバーズの『黄衣の王』における「読むと狂気に陥る戯曲」は、メタフィクションとホラーが交差する原型的事例である。",
      "is_root": false
    },
    {
      "id": "new-weird",
      "title": "ニュー・ウィアード",
      "url": "articles/new-weird.html",
      "summary": "ニュー・ウィアード（New Weird）は、2000年代に顕在化したウィアード・フィクションの現代的再興運動。SF、ファンタジー、ホラーのジャンル境界を意図的に溶解させ、ラヴクラフト的コズミック・ホラーの遺産を政治的・美学的に批判的継承する21世紀文学の重要潮流。",
      "is_root": false
    },
    {
      "id": "arkham",
      "title": "アーカム",
      "url": "articles/arkham.html",
      "summary": "H・P・ラヴクラフトが創造したマサチューセッツ州の架空の町。ミスカトニック大学を擁し、クトゥルフ神話作品群の中心的舞台として機能する。カルコサの「異界の恐怖」と対極をなす「馴染み深い恐怖」の場。",
      "is_root": false
    },
    {
      "id": "forbidden-books",
      "title": "禁断の書物",
      "url": "articles/forbidden-books.html",
      "summary": "禁断の書物（Forbidden Books）とは、読むこと自体が危険であるとされる書物の総称。現実世界の禁書目録からウィアード・フィクションの架空書物まで、「読んではならない」という禁忌の文学的系譜を辿り、ミーム汚染・メタフィクションとの接点を論じる。",
      "is_root": false
    },
    {
      "id": "great-old-ones",
      "title": "旧支配者",
      "url": "articles/great-old-ones.html",
      "summary": "旧支配者（Great Old Ones）は、クトゥルフ神話において太古の地球に君臨し、現在は眠りや封印の状態にあるとされる超自然的存在群の総称。ラヴクラフトの原典における個別の存在描写から、ダーレスによる元素体系への体系化、TRPGにおけるゲームデザインへの応用まで、多層的な変容を重ねてきた。",
      "is_root": false
    },
    {
      "id": "fictional-cities",
      "title": "架空都市の系譜",
      "url": "articles/fictional-cities.html",
      "summary": "文学における架空都市の概念を古代のユートピアから現代のホラー・SFまで通史的に俯瞰する。カルコサ、アーカム、ゴッサムなど、各ジャンルの代表的架空都市の文学的機能を論じる。",
      "is_root": false
    },
    {
      "id": "existential-horror",
      "title": "実存的恐怖",
      "url": "articles/existential-horror.html",
      "summary": "存在そのものへの根源的な不安を恐怖の核とする文学・芸術の様式。実存主義哲学とホラーの交差点。",
      "is_root": false
    },
    {
      "id": "southern-gothic",
      "title": "サザン・ゴシック",
      "url": "articles/southern-gothic.html",
      "summary": "サザン・ゴシック（Southern Gothic）は、アメリカ南部の歴史的・社会的特殊性を恐怖の源泉とする文学的サブジャンル。フォークナー、オコナー、マッカラーズらが確立し、トゥルー・ディテクティブではコズミック・ホラーと融合した。",
      "is_root": false
    },
    {
      "id": "infohazard",
      "title": "情報ハザード",
      "url": "articles/infohazard.html",
      "summary": "情報ハザード（Information Hazard）とは、真実の情報であっても、その流通・取得・理解が何らかの主体に害を与えうるという概念。ニック・ボストロムが2011年に体系化。フィクションの禁断の知識からAI安全性研究まで、現代技術倫理の核心的テーマ。",
      "is_root": false
    },
    {
      "id": "american-civil-war-literature",
      "title": "南北戦争文学",
      "url": "articles/american-civil-war-literature.html",
      "summary": "南北戦争文学（American Civil War Literature）とは、1861年から1865年にかけてのアメリカ南北戦争を題材とした文学作品群の総称。ビアスの戦争短編、クレインの心理的リアリズム、ホイットマンの戦争詩など、近代アメリカ文学の基盤を形成した。",
      "is_root": false
    },
    {
      "id": "house-of-leaves",
      "title": "紙葉の家",
      "url": "articles/house-of-leaves.html",
      "summary": "マーク・Z・ダニエレフスキーの長編小説（2000年）。内部が外部より大きい家を多層的ナラティブで描き、タイポグラフィ・脚注の迷宮を駆使したエルゴード文学の極北。『黄衣の王』の「読むと狂気に陥る書物」の構造をポストモダン的に再構築した。",
      "is_root": false
    }
    ,{
      "id": "arkham-house",
      "title": "アーカム・ハウス",
      "url": "articles/arkham-house.html",
      "summary": "1939年にダーレスとワンドレイが設立した小出版社。ラヴクラフト作品の書籍化とウィアード・フィクションの正典形成に決定的な役割を果たした。",
      "is_root": false
    },
    {
      "id": "miskatonic-university",
      "title": "ミスカトニック大学",
      "url": "articles/miskatonic-university.html",
      "summary": "H・P・ラヴクラフトが創造した架空の大学。アーカムに所在し、ネクロノミコン所蔵の図書館と南極探検隊で知られる。学問的探究が宇宙的恐怖への扉を開く「知識と破滅の不可分性」を象徴する機関。",
      "is_root": false
    },
    {
      "id": "nyarlathotep",
      "title": "ナイアーラトテップ",
      "url": "articles/nyarlathotep.html",
      "summary": "クトゥルフ神話において「這い寄る混沌」の異名を持ち、千の化身を通じて人間社会に直接介入する唯一の宇宙的存在。外なる神々の使者として知性と悪意をもって人間を破滅に導く。",
      "is_root": false
    },
    {
      "id": "outer-gods",
      "title": "外なる神々",
      "url": "articles/outer-gods.html",
      "summary": "クトゥルフ神話体系において旧支配者よりもさらに上位に位置する宇宙的存在群の総称。アザトース、ヨグ=ソトース、ナイアーラトテップ、シュブ=ニグラスを主要な構成員とする。",
      "is_root": false
    },
    {
      "id": "collaborative-fiction",
      "title": "共同創作",
      "url": "articles/collaborative-fiction.html",
      "summary": "複数の作者が共有の世界観・設定を用いてフィクション作品を共同で創造する文学的実践の総称。クトゥルフ神話からSCPファウンデーション、TRPGまで多様な形態を発展させてきた。",
      "is_root": false
    },
    {
      "id": "sanity-mechanics",
      "title": "正気度システム",
      "url": "articles/sanity-mechanics.html",
      "summary": "クトゥルフの呼び声TRPGにおいて導入された、キャラクターの精神的健全さを数値化するゲームメカニクス。SAN値の概念はTRPG史上最も影響力のあるメカニクスのひとつ。",
      "is_root": false
    },
    {
